# ---- MikroTik (utilizador só de leitura) ----
MT_HOST=192.168.88.1
# 8728 = API normal | 8729 = API-SSL (pôr MT_SSL=1)
MT_PORT=8728
MT_SSL=0
MT_SSL_VERIFY=0
MT_USER=monitor
MT_PASS=altera-me

# ---- Interfaces WAN (nome exato no MikroTik: ether1, pppoe-out1, lte1, ...) ----
WAN1_IFACE=ether1
WAN1_LABEL=WAN 1 - Fibra
WAN2_IFACE=ether2
WAN2_LABEL=WAN 2 - Backup
# WAN 3 - ligada ao ether1, gateway 192.168.15.1
# (no mesmo router, cada WAN tem de ter uma interface diferente: ajusta WAN1/WAN2 acima)
WAN3_IFACE=ether1
WAN3_LABEL=WAN 3
WAN3_GATEWAY=192.168.15.1
# Se esta WAN for lida de OUTRO MikroTik (em vez do MT_HOST), descomenta:
#WAN3_HOST=192.168.15.1
#WAN3_USER=monitor
#WAN3_PASS=altera-me
#WAN3_PORT=8728
# (podes acrescentar WAN4_..., WAN5_... até WAN9 da mesma forma)

# ---- Recolha ----
POLL_INTERVAL=2
HISTORY_SECONDS=3600

# ---- Servidor web ----
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# Opcional: proteger a página com utilizador/senha (deixa vazio para desligar)
DASH_USER=
DASH_PASS=

# DEMO=1 gera tráfego fictício (para testar sem router)
DEMO=0
