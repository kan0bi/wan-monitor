[Unit]
Description=WAN Monitor (MikroTik)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wanmon
Group=wanmon
WorkingDirectory=/opt/wan-monitor
EnvironmentFile=/etc/wan-monitor.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wan-monitor/venv/bin/python /opt/wan-monitor/app.py
Restart=always
RestartSec=5
# Sem ProtectSystem/PrivateTmp: em LXC sem privilégios dão erro 226/NAMESPACE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
